<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Sai" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/sai_canvas</item>
        <item name="android:colorBackground">@color/sai_canvas</item>
        <item name="android:colorPrimary">@color/sai_surface</item>
        <item name="android:colorPrimaryDark">@color/sai_canvas</item>
        <item name="android:colorAccent">@color/sai_accent</item>
        <item name="android:colorButtonNormal">@color/sai_surface_raised</item>
        <item name="android:textColorPrimary">@color/sai_text_primary</item>
        <item name="android:textColorSecondary">@color/sai_text_secondary</item>
        <item name="android:textColorHint">@color/sai_text_muted</item>
        <item name="android:statusBarColor">@color/sai_canvas</item>
        <item name="android:navigationBarColor">@color/sai_canvas</item>
        <item name="android:alertDialogTheme">@style/Theme.Sai.Dialog</item>
        <item name="android:colorControlNormal">@color/sai_text_secondary</item>
        <item name="android:colorControlActivated">@color/sai_accent</item>
        <item name="android:colorControlHighlight">@color/sai_accent</item>
    </style>

    <style name="Theme.Sai.Dialog" parent="@android:style/Theme.Material.Dialog">
        <item name="android:colorBackground">@color/sai_surface</item>
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:textColorPrimary">@color/sai_text_primary</item>
        <item name="android:textColorSecondary">@color/sai_text_secondary</item>
        <item name="android:colorAccent">@color/sai_accent</item>
        <item name="android:colorControlActivated">@color/sai_accent</item>
        <item name="android:buttonBarButtonStyle">@style/Widget.Sai.DialogButton</item>
    </style>

    <style name="Widget.Sai.DialogButton" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:textColor">@color/sai_accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
    </style>
</resources>
